# vim: ft=yaml

Checks: >-
  bugprone-*,
  -bugprone-branch-clone,
  -bugprone-easily-swappable-parameters,
  -bugprone-signed-bitwise,
  cert-*,
  clang-diagnostic-*,
  clang-analyzer-*,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  concurrency-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-reference-coroutine-parameters,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-type-vararg,
  google-*,
  -google-explicit-constructor,
  -google-readability-todo,
  -google-readability-braces-around-statements,
  -google-readability-namespace-comments,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -misc-multiple-inheritance,
  -misc-no-recursion,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once,
  readability-*,
  -readability-braces-around-statements,
  -readability-convert-member-functions-to-static,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-redundant-member-init,
  -readability-trailing-comma,
  -readability-uppercase-literal-suffix,
WarningsAsErrors: false
# AnalyzeTemporaryDtors: true
# Why some checks are disabled:
# - bugprone-signed-bitwise: it flags POSIX's int flags, and small unsigned types promoted to int (shifting signed
#   values is well-defined since C++20).
# - clang-analyzer-optin.core.EnumCastOutOfRange: it flags flag enums (e.g. span_flags), whose combinations aren't
#   enumerators.
# - cppcoreguidelines-avoid-do-while: do-while is fine.
# - misc-multiple-inheritance: e.g. socket is both an io::reader and an io::writer, and util::overloaded is the usual
#   visitor idiom.
# - cppcoreguidelines-avoid-reference-coroutine-parameters: tasks are lazy, and awaited where they're made, so
#   reference parameters (e.g. reader/writer, request handlers) outlive them.
# - cppcoreguidelines-pro-bounds-*: they flag every operator[] and pointer arithmetic.
# - misc-include-cleaner: include-what-you-use (see iwyu.imp) decides the includes, and they disagree.
# - portability-avoid-pragma-once: the headers use #pragma once.
# - readability-redundant-member-init: an aggregate's fields are default-initialized ({}) so that designated
#   initializers can leave them out without -Wmissing-designated-field-initializers.
# - readability-trailing-comma: it disagrees with clang-format, which wraps long lists without adding one.
CheckOptions:
# running out of memory is fatal, so noexcept functions may allocate.
- key:   bugprone-exception-escape.IgnoredExceptions
  value: 'bad_alloc,bad_array_new_length,length_error'
- key:   cert-dcl16-c.NewSuffixes
  value: 'L;LL;LU;LLU'
- key:   cert-oop54-cpp.WarnOnlyIfThisHasSuspiciousField
  value: '0'
- key:   cppcoreguidelines-explicit-virtual-functions.IgnoreDestructors
  value: '1'
- key:   cppcoreguidelines-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
  value: '1'
- key:   google-readability-function-size.StatementThreshold
  value: '800'
# locals aren't made const, but references and pointers that could be to const should be.
- key:   misc-const-correctness.AnalyzeValues
  value: 'false'
- key:   misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
  value: '1'
- key:   misc-non-private-member-variables-in-classes.IgnorePublicMemberVariables
  value: '1'
- key:   modernize-loop-convert.MaxCopySize
  value: '16'
- key:   modernize-loop-convert.MinConfidence
  value: reasonable
- key:   modernize-loop-convert.NamingStyle
  value: lower_case
- key:   modernize-pass-by-value.IncludeStyle
  value: llvm
- key:   modernize-replace-auto-ptr.IncludeStyle
  value: llvm
- key:   modernize-use-nullptr.NullMacros
  value: 'NULL'
